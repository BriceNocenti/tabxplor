  - title: Pareto Chart
    name: pareto
    ns: scatr
    menuGroup: Exploration
    menuTitle: Pareto Chart
    menuSubgroup: scatr
    description: Function for making pareto charts.
    options:
      - name: data
        type: Data
        description:
          R: the data as a data frame
      - name: x
        title: X-Axis
        type: Variable
        suggested:
          - nominal
        permitted:
          - factor
        description:
          R: >
            a string naming the variable from `data` that contains the  values
            used for the chart
      - name: counts
        title: Counts (optional)
        type: Variable
        default: null
        suggested:
          - continuous
        permitted:
          - numeric
        description:
          R: >
            a string naming the variable from `data` that contains the  counts
            for the values (optional)
      - name: angle
        title: Angle of x-axis labels
        type: Number
        min: 0
        max: 45
        default: 0
        description:
          R: >
            a number from 0 to 45 defining the angle of the x-axis labels, 
            where 0 degrees represents completely horizontal labels.
    uijs: "(function(f){if(typeof exports===\"object\"&&typeof module!==\"undefined\"){module.exports=f()}else if(typeof define===\"function\"&&define.amd){define([],f)}else{var g;if(typeof window!==\"undefined\"){g=window}else if(typeof global!==\"undefined\"){g=global}else if(typeof self!==\"undefined\"){g=self}else{g=this}g.module = f()}})(function(){var define,module,exports;return (function(){function r(e,n,t){function o(i,f){if(!n[i]){if(!e[i]){var c=\"function\"==typeof require&&require;if(!f&&c)return c(i,!0);if(u)return u(i,!0);var a=new Error(\"Cannot find module '\"+i+\"'\");throw a.code=\"MODULE_NOT_FOUND\",a}var p=n[i]={exports:{}};e[i][0].call(p.exports,function(r){var n=e[i][1][r];return o(n||r)},p,p.exports,r,e,n,t)}return n[i].exports}for(var u=\"function\"==typeof require&&require,i=0;i<t.length;i++)o(t[i]);return o}return r})()({1:[function(require,module,exports){\n\r\n// This file is an automatically generated and should not be edited\r\n\r\n'use strict';\r\n\r\nconst options = [{\"name\":\"data\",\"type\":\"Data\",\"description\":{\"R\":\"the data as a data frame\"}},{\"name\":\"x\",\"title\":\"X-Axis\",\"type\":\"Variable\",\"suggested\":[\"nominal\"],\"permitted\":[\"factor\"],\"description\":{\"R\":\"a string naming the variable from `data` that contains the  values used for the chart\\n\"}},{\"name\":\"counts\",\"title\":\"Counts (optional)\",\"type\":\"Variable\",\"default\":null,\"suggested\":[\"continuous\"],\"permitted\":[\"numeric\"],\"description\":{\"R\":\"a string naming the variable from `data` that contains the  counts for the values (optional)\\n\"}},{\"name\":\"angle\",\"title\":\"Angle of x-axis labels\",\"type\":\"Number\",\"min\":0,\"max\":45,\"default\":0,\"description\":{\"R\":\"a number from 0 to 45 defining the angle of the x-axis labels,  where 0 degrees represents completely horizontal labels.\\n\"}}];\r\n\r\nconst view = function() {\r\n    \r\n    \r\n\r\n    View.extend({\r\n        jus: \"2.0\",\r\n\r\n        event