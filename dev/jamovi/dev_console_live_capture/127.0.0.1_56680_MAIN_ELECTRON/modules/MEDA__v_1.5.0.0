  - title: Description of a Contingency Table
    name: descfreq
    ns: MEDA
    menuGroup: MEDA
    menuTitle: By Columns / Rows (Contingency Table)
    menuSubgroup: Automatic Univariate Description
    menuSubtitle: FactoMineR::descfreq
    options:
      - name: data
        type: Data
      - name: rows
        title: Rows
        type: Variable
        suggested:
          - nominal
        permitted:
          - factor
      - name: columns
        title: Columns (>1)
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: tuto
        title: Read me before running
        type: Bool
        default: true
      - name: threshold
        title: Significance threshold (%)
        type: Number
        default: 5
