  - title: Correspondence Analysis
    name: CA
    ns: MEDA
    menuGroup: MEDA
    menuTitle: Correspondence Analysis
    menuSubgroup: Multivariate Analysis
    menuSubtitle: FactoMineR::CA
    options:
      - name: donnees
        type: Data
      - name: activecol
        title: Active Columns (>1)
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: illustrativecol
        title: Supplementary Columns
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: indiv
        title: Row Labels
        type: Variable
        suggested:
          - nominal
        permitted:
          - factor
      - name: tuto
        title: Read me before running
        type: Bool
        default: true
      - name: nbfact
        title: Number of dimensions
        type: Integer
        default: 2
      - name: proba
        title: Significance threshold (%)
        type: Number
        default: 5
      - name: abs
        title: X-axis
        type: Integer
        default: 1
      - name: ord
        title: Y-axis
        type: Integer
        default: 2
      - name: limcoscol
        title: Columns
        type: Number
        default: 0
      - name: limcosrow
        title: Rows
        type: Number
        default: 0
      - name: ellipsecol
        title: Around columns
        type: Bool
        default: false
      - name: ellipserow
        title: Around rows
        type: Bool
        default: false
      - name: addillucol
        title: Add supplementary columns on the graphs
        type: Bool
        default: true
      - name: coordcol
        title: Coordinates
        type: Bool
        default: false
      - name: contribcol
        title: Contributions
        type: Bool
        default: false
      - name: coscol
        title: Cosine
        type: Bool
        default: false
      - name: coordrow
        title: Coordinates
        type: Bool
        default: false
      - name: contribrow
        title: Contributions
        type: Bool
        default: false
      - name: cosrow
        title: Cosine
        type: Bool
        default: false
      - name: ncp
        title: Number of components
        type: Integer
        default: 5
      - name: graphclassif
        title: Representation of the clusters
        type: Bool
        default: false
      - name: newvar
        title: Coordinates
        type: Output
      - name: nbclust
        title: Number of clusters
        type: Integer
        default: -1
      - name: newvar2
        title: Cluster variable
        type: Output
