  - title: Categorical Variable Described by Textual Data
    name: textual
    ns: MEDA
    menuGroup: MEDA
    menuTitle: By Textual Data
    menuSubgroup: Automatic Univariate Description
    menuSubtitle: FactoMineR::textual/descfreq
    options:
      - name: data
        type: Data
      - name: individuals
        title: Variable to Characterize
        type: Variable
        suggested:
          - nominal
        permitted:
          - factor
      - name: words
        title: Described by
        type: Variable
      - name: tuto
        title: Read me before running
        type: Bool
        default: true
      - name: thres
        title: Significance threshold (%)
        type: Number
        default: 5
      - name: lowfreq
        title: Lowest frequency words
        type: Number
        default: 0
      - name: highfreq
        title: Highest frequency words
        type: Number
        default: 0
