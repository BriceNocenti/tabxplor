  - title: Transpose
    name: jtTranspose
    ns: jTransform
    menuGroup: Data
    menuSubgroup: jTransform
    menuTitle: Transpose
    description: Transpose a Data Set
    options:
      - name: data
        type: Data
      - name: varNme
