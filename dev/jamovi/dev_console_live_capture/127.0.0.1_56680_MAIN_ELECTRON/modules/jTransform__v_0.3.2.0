        title: Variables To Be Transformed
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: varExc
        title: Variables NOT To Be Transformed
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: varOrd
        title: Organization of Variables in the Output
        type: List
        options:
          - title: Time Steps Are Adjacent
            name: times
          - title: Variables Are Adjacent
            name: vars
        default: times
      - name: varAgg
        title: How to Accumulate?
        type: List
        options:
          - title: Calculate Mean
            name: mean
          - title: First Occurence
            name: first
        default: mean
      - name: varSep
        title: Separator
        type: String
        default: _
      - name: btnCrt
        type: Action
        title: Create
        default: false
