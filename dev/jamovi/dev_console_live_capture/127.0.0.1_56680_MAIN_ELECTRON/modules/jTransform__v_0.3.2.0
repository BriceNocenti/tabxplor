  - title: Wide to Long
    name: jtWide2Long
    ns: jTransform
    menuGroup: Data
    menuSubgroup: jTransform
    menuTitle: Wide to Long
    description: Transform a Data Set From Wide to Long
    options:
      - name: data
        type: Data
      - name: mdeW2L
        title: Mode
        type: List
        options:
          - name: Sep
            title: Separated
          - name: NSS
            title: Non-Sep. (Simple)
          - name: NSA
            title: Non-Sep. (Advanced)
        default: Sep
      - name: id_Sep
        title: Variables That Identify the Same Unit
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: xfmSep
        title: Variables To Be Transformed
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: excSep
        title: Variables NOT To Be Transformed
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: pfxSep
        title: Prefix
        type: String
        default: cond
      - name: chrSep
        title: Separator
        type: String
        default: _
      - name: lvlSep
        title: Exclude Level
        type: String
        default: ''
      - name: id_NSS
        title: Variables That Identify the Same Unit
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: xfmNSS
        title: Variables To Be Transformed
        type: Variables
        default: null
      - name: excNSS
        title: Variables NOT To Be Transformed
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: idxNSS
        title: Index for Repeated Measures Levels
        type: String
        default: index
      - name: tgtNSS
        title: Name of the Target Variable
        type: String
        default: var
      - name: id_NSA
        title: Variables That Identify the Same Unit
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
