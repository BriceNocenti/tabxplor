  - title: Long to Wide
    name: jtLong2Wide
    ns: jTransform
    menuGroup: Data
    menuSubgroup: jTransform
    menuTitle: Long to Wide
    description: Transform a Data Set From Long to Wide
    options:
      - name: data
        type: Data
      - name: varID
        title: Variables That Identify the Same Unit
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: varTme
        title: Variables That Differentiate Within a Unit
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
