  - title: Replace
    name: jtReplace
    ns: jTransform
    menuGroup: Data
    menuSubgroup: jTransform
    menuTitle: Replace
    description: Replace Values in the Current Data Set
    options:
      - name: data
        type: Data
      - name: varAll
        type: Variables
        hidden: true
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: rplTrm
        type: Array
        template:
          type: Group
          elements:
            - name: rplOld
              type: String
            - name: rplNew
              type: String
        default:
          - rplOld: ''
            rplNew: ''
      - name: whlTrm
        title: Whole Word
        type: Bool
        default: true
      - name: btnCrt
        type: Action
        title: Create
        default: false
      - name: incCmp
        title: Computed
        type: Bool
        default: true
      - name: incRcd
        title: Transformed
        type: Bool
        default: true
      - name: incID
        title: ID
        type: Bool
        default: true
      - name: incNom
        title: Nominal
        type: Bool
        default: true
      - name: incOrd
        title: Ordinal
        type: Bool
        default: true
      - name: incNum
        title: Continuous
        type: Bool
        default: true
      - name: incExc
        type: List
        options:
          - name: include
            title: Include
          - name: exclude
            title: Exclude
        default: include
      - name: varSel
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
