  - title: Sort
    name: jtSort
    ns: jTransform
    menuGroup: Data
    menuSubgroup: jTransform
    menuTitle: Sort
    description: Sort Data Set
    options:
      - name: data
        type: Data
      - name: varSrt
        title: Variable(s) to Sort After
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: varAll
        type: Variables
        hidden: true
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: ordSrt
        type: Array
        items: (varSrt)
        template:
          type: Group
          elements:
            - name: var
              type: Variable
              content: $key
            - name: order
              type: List
              options:
                - name: ascend
                  title: Ascending
                - name: descend
                  title: Descending
        default: null
      - name: btnCrt
        type: Action
        title: Create
        default: false
