  - title: Merge (Add Columns)
    name: jtMergeCols
    ns: jTransform
    menuGroup: Data
    menuSubgroup: jTransform
    menuTitle: Merge (Add Columns)
    description: Add Columns (From Other Data Sets)
    options:
      - name: data
        type: Data
        description:
          R: the data as a data frame
      - name: varBy
        title: Variable(s) to Match the Data Sets By
        type: Variables
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: varAll
        title: Further Variables in the Output
        type: Variables
        hidden: true
        permitted:
          - numeric
          - factor
          - id
        default: null
      - name: fleInp
        type: String
        title: 'Data Set(s) to Add:'
        default: ''
      - name: tglChs
        type: Bool
        hidden: true
        default: false
      - name: fleChs
        type: String
        hidden: true
        default: ''
      - name: typMrg
        title: Type of Merging Operation
        type: List
        options:
          - title: Keeps All Cases (Rows)
            name: outer
          - title: Keeps Only Cases Contained in All Merged Data Sets
            name: inner
          - title: Keeps All Cases From the Currently Opened Data Set
            name: left
          - title: Keeps All Cases From the Data Sets To Be Added
            name: right
        default: outer
      - name: btnCrt
        type: Action
        title: Create
        default: false
