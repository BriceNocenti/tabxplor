  - title: Linear Regression
    name: regression
    ns: jmvbaseR
    menuGroup: Base R
    menuSubgroup: Regression
    menuTitle: Linear Regression
    options:
      - name: data
        type: Data
        description:
          R: the data set as a data frame
      - name: dep
        title: Dependent Variable
        type: Variable
        default: null
