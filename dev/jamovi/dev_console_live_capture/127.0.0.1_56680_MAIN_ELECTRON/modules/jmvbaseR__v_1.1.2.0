---
title: Base R
name: jmvbaseR
version: 1.1.2
jms: '1.0'
authors:
  - Jonathon Love
  - Damian Dropmann
  - Ravi Selker
maintainer: Jonathon Love <jon@thon.cc>
date: '2018-02-15'
type: R
description: >
  A simple module which makes the analyses from the stats package (included with
  R) useable from jamovi. This module is ideal for teaching and learning R (when
  run in 'syntax mode') as it demonstrates the syntax for some basic but common
  R analyses.
analyses:
  - title: Independent Samples T-Test
    name: ttestIS
    ns: jmvbaseR
    menuGroup: Base R
    menuSubgroup: T-Test
    menuTitle: Independent Samples T-Test
    menuSubtitle: null
    description: null
    options:
      - name: data
        type: Data
        description:
          R: the data as a data frame
      - name: dependent
        title: Dependent Variable
        type: Variable
        description:
          R: a string specifying the dependent variable in `data`
      - name: grouping
        title: Grouping Variable
        type: Variable
        description:
          R: >
            a string specifying the grouping variable in `data`; must have two
            levels
      - name: alternative
        title: alternative
        type: List
        options:
          - two.sided
          - less
          - greater
        default: two.sided
        description:
          R: |
            `'two.sided'`, `'less'`, or `'greater'`
      - name: mu
        title: mu
        type: Number
        default: 0
        description:
          R: a number, the mean of the null hypothesis
      - name: varEqual
        title: var.equal
        type: Bool
        default: false
        description:
          R: TRUE or FALSE (default), assume equal variances
      - name: confLevel
        title: conf.level
        type: Number
        default: 0.95
        description:
          R: >
            a number between 0 and 1 (default: 0.95), specifying the confidence
            interval width
