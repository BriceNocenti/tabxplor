---
title: Rj - Editor to run R code inside jamovi
name: Rj
version: 2.5.0
jms: '1.0'
usesNative: true
minApp: 2.5.0
authors:
  - Jonathon Love
  - Maurizio Agosti
maintainer: Jonathon Love <jon@thon.cc>
type: R
description: >-
  Provides an editor allowing you to enter R code, and analyse your data using R
  inside jamovi.
analyses:
  - title: Rj Editor
    name: Rj
    ns: Rj
    menuGroup: R
    menuTitle: Rj Editor
    menuSubgroup: Rj
    arbitraryCode: true
    options:
      - name: data
        type: Data
      - name: code
        default: |

          # summary(data[1:3])
        type: String
        hidden: true
      - name: R
        title: R version
        type: List
        hidden: true
        options:
          - name: bundled
            title: jamovi R
          - name: external
            title: System R
        default: bundled
      - name: vars
        type: Variables
        hidden: true
        permitted:
          - factor
          - numeric
          - id
      - name: output
        type: List
        hidden: true
        options:
          - noEcho
          - echo
        default: noEcho
      - name: figWidth
        type: String
        default: ''
        hidden: true
      - name: figHeight
        type: String
        default: ''
        hidden: true
      - name: toggle
        type: Bool
        default: false
        hidden: true
    uijs: "(function(f){if(typeof exports===\"object\"&&typeof module!==\"undefined\"){module.exports=f()}else if(typeof define===\"function\"&&define.amd){define([],f)}else{var g;if(typeof window!==\"undefined\"){g=window}else if(typeof global!==\"undefined\"){g=global}else if(typeof self!==\"undefined\"){g=self}else{g=this}g.module = f()}})(function(){var define,module,exports;return (function(){function r(e,n,t){function o(i,f){if(!n[i]){if(!e[i]){var c=\"function\"==typeof require&&require;if(!f&&c)return c(i,!0);if(u)return u(i,!0);var a=new Error(\"Cannot find module '\"+i+\"'\");throw a.code=\"MODULE_NOT_FOUND\",a}var p=n[i]={exports:{}};e[i][0].call(p.exports,function(r){var n=e[i][1][r];return o(n||r)},p,p.exports,r,e,n,t)}return n[i].exports}for(var u=\"function\"==typeof require&&require,i=0;i<t.length;i++)o(t[i]);return o}return r})()({1:[function(require,module,exports){\n\r\nconst css = `\r\n#editor-box {\r\n    margin-bottom: 6px ;\r\n    flex-grow: 1 ;\r\n    display: flex ;\r\n    flex-direction: column ;\r\n    position: relative ;\r\n}\r\n\r\n#editor {\r\n    border: 1px solid #AAAAAA ;\r\n    flex-grow: 1 ;\r\n}\r\n\r\n#toolbar {\r\n    display: flex ;\r\n    position: absolute ;\r\n    top: 4px ;\r\n    right: 24px ;\r\n    z-index: 10 ;\r\n}\r\n\r\n#info {\r\n    display: flex ;\r\n    position: absolute ;\r\n    bottom: 4px ;\r\n    right: 16px ;\r\n    color: #333333 ;\r\n}\r\n\r\n#run, #config {\r\n    width: 21px ;\r\n    height: 21px ;\r\n    border-radius: 2px ;\r\n    background-size: auto 80% ;\r\n    background-position: center ;\r\n    background-repeat: no-repeat ;\r\n}\r\n\r\n#run:hover, #config:hover {\r\n    background-color: #EEEEEE ;\r\n}\r\n\r\n#menu {\r\n    opacity: 0 ;\r\n    pointer-events: none ;\r\n    transition: .1s all ;\r\n\r\n    display: grid ;\r\n    position: absolute ;\r\n    top: 24px ;\r\n    right: 0px ;\r\n    color: #333333 ;\r\n    background-color: #f4f4f4 ;\r\n    border: 1px solid #C1C1C1 ;\r\n    box-shadow: 0px 0px 5px #C1C1C1 ;\r\n    border-radius: 2px ;\r\n    z-index: 20 ;\r\n\r\n    padding: 12px ;\r\n    align-items: center ;\r\n    grid-column-gap: 6px ;\r\n    grid-row-gap: 12px ;\r\n}\r\n\r\n#menu.visible {\r\n    opacity: 1 ;\r\n    pointer-events: auto ;\r\n}\r\n\r\n#menu > label {\r\n    grid-column: 1 ;\r\n    white-space: nowrap ;\r\n}\r\n\r\n#output-label, #output {\r\n    grid-row: 1 ;\r\n}\r\n\r\n#output {\r\n    grid-column: 2 / span 2 ;\r\n}\r\n\r\n#r-label, #r-version {\r\n    grid-row: 3 ;\r\n}\r\n\r\n#figure-size {\r\n    grid-row: 2;\r\n    grid-column: 1 / span 2 ;\r\n    display: grid ;\r\n    justify-content: left ;\r\n    align-items: baseline ;\r\n    grid-gap: 4px ;\r\n    margin: 10px 0px;\r\n}\r\n\r\n#figure-size-title {\r\n    grid-column: 1 / span 2;\r\n    margin-bottom: 8px;\r\n    font-weight: bold;\r\n}\r\n\r\n#figure-size label {\r\n    padding-left: 12px ;\r\n    grid-column: 1 ;\r\n}\r\n\r\n#figure-size input {\r\n    width: 50px;\r\n    grid-column: 2 ;\r\n}\r\n\r\n#run {\r\n    background-image: url('data:image/svg+xml;base64,');\r\n}\r\n\r\n#config {\r\n    background-image: url('data:image/svg+xml;base64,');\r\n\r\n    margin-right: 3px;\r\n}\r\n\r\n.ace_editor.ace_autocomplete .ace_completion-highlight {\r\n    color: inherit ;\r\n    text-shadow: none ;\r\n}\r\n\r\n.ace_editor.ace_autocomplete .ace_line {\r\n    line-height: 20px ;\r\n}\r\n\r\n.ace_icon_data,\r\n.ace_icon_func,\r\n.ace_icon_var,\r\n.ace_icon_ns {\r\n    display: inline-block ;\r\n    width: 24px ;\r\n    background-repeat: no-repeat ;\r\n    background-size: 12px ;\r\n    background-position: center ;\r\n}\r\n\r\n.ace_icon_data {\r\n    background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABYAAAAWCAYAAADEtGw7AAAAQklEQVR42mOImrXnPy0wA4jYeu8jVfGowZgG0yTy2jqn/8cFLly4SpYcyMwhajBIETXxEA6K0TAeDePRMMZjMC0wAFMtrQuuiigOAAAAAElFTkSuQmCC');\r\n}\r\n\r\n.ace_icon_func {\r\n    background-image: url('data:image/svg+xml;base64,');\r\n}\r\n\r\n.ace_icon_ns {\r\n    background-image: url('data:image/svg+xml;base64,');\r\n}\r\n\r\n`;\r\n\r\nlet node = document.createElement('style');\r\nnode.innerHTML = css;\r\ndocument.body.appendChild(node);\r\n\r\nmodule.exports = undefined;\r\n\n},{}],2:[function(require,module,exports){\nmodule.exports=[{\"name\":\"abbreviate\",\"value\":\"abbreviate\",\"meta\":\"{base}\",\"type\":\"func\",\"ns\":\"base\"},{\"name\":\"abline\",\"value\":\"abline\",\"meta\":\"{graphics}\",\"type\":\"func\",\"ns\":\"graphics\"},{\"name\":\"abs\",\"value\":\"abs\",\"meta\":\"{base}\",\"type\":\"func\",\"ns\":\"base\"},{\"name\":\"acf\",\"value\":\"acf\",\"meta\":\"{stats}\",\"type\":\"func\",\"ns\":\"stats\"},{\"name\":\"acf2AR\",\"value\":\"acf2AR\",\"meta\":\"{stats}\",\"type\":\"func\",\"ns\":\"stats\"},{\"name\":\"acos\",\"value\":\"acos\",\"meta\":\"{base}\",\"type\":\"func\",\"ns\":\"base\"},{\"name\":\"acosh\",\"value\":\"acosh\",\"meta\":\"{base}\",\"type\":\"func\",\"ns\":\"base\"},{\"name\":\"add.scope\",\"value\":\"add.scope\",\"meta\":\"{stats}\",\"type\":\"func\",\"ns\":\"stats\"},{\"name\":\"add1\",\"value\":\"add1\",\"meta\":\"{stats}\",\"type\":\"func\",\"ns\":\"stats\"},{\"name\":\"addmargins\",\"value\":\"addmargins\",\"meta\":\"{stats}\",\"type\":\"func\",\"ns\":\"stats\"},{\"name\":\"addNA\",\"value\":\"addNA\",\"meta\":\"{base}\",\"type\":\"func\",\"ns\":\"base\"},{\"name\":\"addNextMethod\",\"value\":\"addNextMethod\",\"meta\":\"{methods}\",\"type\":\"func\",\"ns\":\"methods\"},{\"name\":\"addTaskCallback\",\"value\":\"addTaskCallback\",\"meta\":\"{base}\",\"type\":\"func\",\"ns\":\"base\"},{\"name\":\"adist\",\"value\":\"adist\",\"meta\":\"{utils}\",\"type\":\"func\",\"ns\":\"utils\"},{\"name\":\"adjustcolor\",\"value\":\"adjustcolor\",\"meta\":\"{grDevices}\",\"type\":\"func\",\"ns\":\"grDevices\"},{\"name\":\"aggregate\",\"value\":\"aggregate\",\"meta\":\"{stats}\",\"type\":\"func\",\"ns\":\"stats\"},{\"name\":\"aggregate.data.frame\",\"value\":\"aggregate.data.frame\",