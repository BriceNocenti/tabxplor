  - title: Linear Discriminant Analysis
    name: disc
    ns: snowCluster
    menuGroup: snowCluster
    menuTitle: Linear Discriminant Analysis
    menuSubgroup: Classification
    options:
      - name: data
        type: Data
      - name: dep
        type: Variable
        title: Dependent
        suggested:
          - nominal
        permitted:
          - factor
      - name: covs
        title: Covariates
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: per
        title: Split set
        type: Number
        min: 0.1
        max: 1
        default: 1
      - name: prior
        title: Prior probability
        type: Bool
        default: true
      - name: gm
        title: Group means
        type: Bool
        default: false
      - name: coef
        title: Coefficients of discriminants
        type: Bool
        default: false
      - name: prop
        title: Proportion of trace
        type: Bool
        default: false
      - name: tra
        title: Training set
        type: Bool
        default: false
      - name: tes
        title: Test set
        type: Bool
        default: false
      - name: plot
        title: LD plot
        type: Bool
        default: false
      - name: plot1
        title: Histogram
        type: Bool
        default: false
      - name: plot2
        title: Partition plots
        type: Bool
        default: false
      - name: method
        title: Method
        type: List
        options:
          - lda
          - qda
        default: lda
      - name: width
        type: Integer
        title: 'Size: '
        default: 500
      - name: height
        type: Integer
        title: X
        default: 500
      - name: width1
        type: Integer
        title: 'Size: '
        default: 500
      - name: height1
        type: Integer
        title: X
        default: 500
      - name: width2
        type: Integer
        title: 'Size: '
        default: 500
      - name: height2
        type: Integer
        title: X
