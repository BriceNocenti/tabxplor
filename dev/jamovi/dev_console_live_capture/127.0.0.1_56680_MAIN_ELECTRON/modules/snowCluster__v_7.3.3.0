        type: Bool
        default: false
      - name: quanti
        title: Quantitative variables
        type: Bool
        default: false
      - name: qual
        title: Qualitative variables
        type: Bool
        default: false
      - name: plot
        title: Scree plot
        type: Bool
        default: true
