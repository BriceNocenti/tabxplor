  - title: Multiple Factor Analysis
    name: mfa
    ns: snowCluster
    menuGroup: snowCluster
    menuSubgroup: Correspondence & Factor
    menuTitle: Multiple Factor Analysis
    options:
      - name: data
        type: Data
        description:
          R: |
            The data as a data frame.
      - name: vars
        title: Variables
        type: Variables
      - name: facs
        title: Factor(Optional)
        type: Variable
        suggested:
          - nominal
        permitted:
          - factor
      - name: labels
        title: Labels(Optional)
        type: Variable
        suggested:
          - id
        permitted:
          - id
          - factor
      - name: group
        title: Number of variables within group
        type: String
        default: 2,5,3,10,9,2
      - name: type
        title: Type of variable
        type: String
        default: n,s,s,s,s,s
      - name: gn
        title: The name of groups
        type: String
        default: a,b,c,d,e,f
      - name: eigen
        title: Eigenvalues
        type: Bool
        default: true
      - name: colvar
        title: Type
        type: List
        options:
          - coordinates
          - cos2
          - contribution
        default: coordinates
      - name: rowvar
        title: Type
        type: List
        options:
          - coordinates
          - cos2
          - contribution
        default: coordinates
      - name: cg
        title: Groups of variables
        type: Bool
        default: false
      - name: ci
        title: Individuals
        type: Bool
        default: false
      - name: quanti
        title: Quantitative variables
        type: Bool
        default: false
      - name: quanvar
        title: Type
        type: List
        options:
          - coordinates
          - cos2
          - contribution
        default: coordinates
      - name: plot
        title: Variable groups
        type: Bool
        default: false
      - name: plot1
        title: Quantitative variables colored by groups
        type: Bool
        default: false
      - name: plot2
        title: Contribution to dimension 1
        type: Bool
        default: false
      - name: plot3
        title: Contribution to dimension 2
        type: Bool
        default: false
      - name: plot4
        title: Graph of individuals
        type: Bool
        default: false
      - name: plot5
        title: Individuals by group
        type: Bool
        default: false
      - name: plot6
        title: Cotribution of groups to dimension 1
        type: Bool
        default: false
      - name: plot7
        title: Cotribution of groups to dimension 2
        type: Bool
        default: false
      - name: plot8
        title: Scree plot
        type: Bool
        default: false
      - name: angle
        title: Angle of x-axis labels
        type: Number
        min: 0
        max: 90
        default: 0
      - name: width
        type: Integer
        title: 'Size: '
        default: 500
      - name: height
        type: Integer
        title: X
        default: 500
      - name: width1
        type: Integer
        title: 'Size: '
        default: 500
      - name: height1
        type: Integer
        title: X
        default: 500
      - name: width2
        type: Integer
        title: 'Size: '
        default: 500
      - name: height2
        type: Integer
        title: X
        default: 500
      - name: width3
        type: Integer
        title: 'Size: '
        default: 500
      - name: height3
        type: Integer
        title: X
        default: 500
      - name: width4
        type: Integer
        title: 'Size: '
        default: 500
      - name: height4
        type: Integer
        title: X
        default: 500
      - name: width5
        type: Integer
        title: 'Size: '
        default: 500
      - name: height5
        type: Integer
        title: X
        default: 500
      - name: width6
        type: Integer
        title: 'Size: '
        default: 500
      - name: height6
        type: Integer
        title: X
        default: 500
      - name: width7
        type: Integer
        title: 'Size: '
        default: 500
      - name: height7
        type: Integer
        title: X
        default: 500
      - name: width8
        type: Integer
        title: 'Size: '
        default: 500
      - name: height8
        type: Integer
