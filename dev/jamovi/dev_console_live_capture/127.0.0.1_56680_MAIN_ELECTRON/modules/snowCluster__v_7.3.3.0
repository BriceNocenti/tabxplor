  - title: Univariate time series
    name: arima
    ns: snowCluster
    menuGroup: snowCluster
    menuTitle: Univariate time series
    menuSubgroup: Time series
    options:
      - name: data
        type: Data
        description:
          R: timeseries data format
      - name: mode
        title: ''
        type: List
        options:
          - name: simple
            title: ARIMA
          - name: complex
            title: Prophet
        default: simple
      - name: dep
        type: Variable
        title: Variable named y
        suggested:
          - continuous
        permitted:
          - numeric
        description:
          R: |
            the dependent variable from `data`, variable must be numeric
      - name: dep1
        type: Variable
        title: Variable named y
        suggested:
          - continuous
        permitted:
          - numeric
        description:
          R: |
            the dependent variable from `data`, variable must be numeric
      - name: time1
        title: Time variable named ds
        type: Variables
        rejectUnusedLevels: true
        suggested:
          - nominal
        default: null
        description:
          R: ts type called 'ds'
      - name: freq
        title: Frequency
        type: Integer
        min: 1
        default: 12
      - name: pred
        title: Prediction
        type: Integer
        min: 1
        default: 10
      - name: plot
        title: Decomposition
        type: Bool
        default: false
      - name: box
        title: Box plot
        type: Bool
        default: false
      - name: plot1
        title: Automatic ARIMA forecasts
