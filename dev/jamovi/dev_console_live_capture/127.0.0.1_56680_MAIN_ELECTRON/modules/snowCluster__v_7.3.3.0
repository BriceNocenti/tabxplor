  - title: Decision Tree
    name: tree
    ns: snowCluster
    menuGroup: snowCluster
    menuTitle: Decision Tree
    menuSubgroup: Classification
    options:
      - name: data
        type: Data
      - name: dep
        type: Variable
        title: Dependent Variable
        suggested:
          - nominal
        permitted:
          - factor
      - name: covs
        title: Covariates
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: facs
        title: Factors
        type: Variables
        suggested:
          - nominal
          - ordinal
        permitted:
          - factor
      - name: per
        title: Split set
        type: Number
        min: 0.1
        max: 1
        default: 0.7
      - name: over1
        title: Overall statistics
        type: Bool
        default: true
      - name: tab1
        title: Confusion matrix
        type: Bool
        default: false
      - name: over2
        title: Overall statistics
        type: Bool
        default: false
      - name: tab2
        title: Confusion matrix
        type: Bool
        default: false
      - name: cla
        title: Statistics by class
        type: Bool
        default: false
      - name: plot
        title: Decision tree
        type: Bool
        default: false
      - name: plot1
        title: rpart tree
        type: Bool
        default: false
      - name: width
        type: Integer
        title: 'Size: '
        default: 500
      - name: height
        type: Integer
        title: X
        default: 500
      - name: width1
        type: Integer
        title: 'Size: '
        default: 500
      - name: height1
        type: Integer
        title: X
        default: 500
