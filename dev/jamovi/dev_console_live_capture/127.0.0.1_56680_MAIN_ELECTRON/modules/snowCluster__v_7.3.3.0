---
title: Multivariate Analysis
name: snowCluster
version: 7.3.3
jms: '1.0'
authors:
  - Hyunsoo Seol
maintainer: Hyunsoo Seol <snow@cau.ac.kr>
date: '2024-05-02'
type: R
description: >-
  This module allows users to analyze k-means and hierarchical
  clustering,Correspondence Analysis, Multiple Factor Analysis, Factor analysis
  of mixed data, Discriminant Analysis, Multidimensional Scaling, Univariate
  time series, Prophet analysis, Decision Tree, Machine Learning,and various
  visualization results.
analyses:
  - title: K-means Clustering
    name: kmeans
    ns: snowCluster
    menuGroup: snowCluster
    menuTitle: K-means Clustering
    menuSubgroup: Cluster Analysis
    options:
      - name: data
        type: Data
        description:
          R: |
            The data as a data frame.
      - name: vars
        title: Variables
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: k
        title: Number of clusters
        default: 2
        type: Integer
        min: 1
      - name: algo
        title: Algorithm
        type: List
        options:
          - title: Hartigan-Wong
            name: Hartigan-Wong
          - title: Lloyd
            name: Lloyd
          - title: Forgy
            name: Forgy
          - title: MacQueen
            name: MacQueen
        default: Hartigan-Wong
      - name: nstart
        title: Number of random starting values
        type: Integer
        default: 10
      - name: stand
        title: Standardize variables
        type: Bool
        default: false
      - name: plot
        title: Plot of means across clusters
        type: Bool
        default: true
      - name: angle
        title: Angle of x-axis labels
        type: Number
        min: 0
        max: 90
        default: 0
        description:
          R: >
            a number from 0 to 90 defining the angle of the x-axis labels, 
            where 0 degrees represents completely horizontal labels.
      - name: plot1
        title: Optimal number of clusters
        type: Bool
        default: false
      - name: plot2
        title: Cluster plot
        type: Bool
        default: false
      - name: plot3
        title: Variables-PCA
        type: Bool
        default: false
      - name: clust
        title: Cluster number
        type: Output
      - name: width
        type: Integer
        title: 'Size: '
        default: 500
      - name: height
        type: Integer
        title: X
        default: 500
      - name: width1
        type: Integer
        title: 'Size: '
        default: 500
      - name: height1
        type: Integer
        title: X
        default: 500
      - name: width2
        type: Integer
        title: 'Size: '
        default: 500
      - name: height2
        type: Integer
        title: X
        default: 500
      - name: width3
        type: Integer
        title: 'Size: '
        default: 500
      - name: height3
        type: Integer
        title: X
        default: 500
    uijs: "(function(f){if(typeof exports===\"object\"&&typeof module!==\"undefined\"){module.exports=f()}else if(typeof define===\"function\"&&define.amd){define([],f)}else{var g;if(typeof window!==\"undefined\"){g=window}else if(typeof global!==\"undefined\"){g=global}else if(typeof self!==\"undefined\"){g=self}else{g=this}g.module = f()}})(function(){var define,module,exports;return (function(){function r(e,n,t){function o(i,f){if(!n[i]){if(!e[i]){var c=\"function\"==typeof require&&require;if(!f&&c)return c(i,!0);if(u)return u(i,!0);var a=new Error(\"Cannot find module '\"+i+\"'\");throw a.code=\"MODULE_NOT_FOUND\",a}var p=n[i]={exports:{}};e[i][0].call(p.exports,function(r){var n=e[i][1][r];return o(n||r)},p,p.exports,r,e,n,t)}return n[i].exports}for(var u=\"function\"==typeof require&&require,i=0;i<t.length;i++)o(t[i]);return o}return r})()({1:[function(require,module,exports){\n\r\n// This file is an automatically generated and should not be edited\r\n\r\n'use strict';\r\n\r\nconst options = [{\"name\":\"data\",\"type\":\"Data\",\"description\":{\"R\":\"The data as a data frame.\\n\"}},{\"name\":\"vars\",\"title\":\"Variables\",\"type\":\"Variables\",\"suggested\":[\"continuous\"],\"permitted\":[\"numeric\"]},{\"name\":\"k\",\"title\":\"Number of clusters\",\"default\":2,\"type\":\"Integer\",\"min\":1},{\"name\":\"algo\",\"title\":\"Algorithm\",\"type\":\"List\",\"options\":[{\"title\":\"Hartigan-Wong\",\"name\":\"Hartigan-Wong\"},{\"title\":\"Lloyd\",\"name\":\"Lloyd\"},{\"title\":\"Forgy\",\"name\":\"Forgy\"},{\"title\":\"MacQueen\",\"name\":\"MacQueen\"}],\"default\":\"Hartigan-Wong\"},{\"name\":\"nstart\",\"title\":\"Number of random starting values\",\"type\":\"Integer\",\"default\":10},{\"name\":\"stand\",\"title\":\"Standardize variables\",\"type\":\"Bool\",\"default\":false},{\"name\":\"plot\",\"title\":\"Plot of means across clusters\",\"type\":\"Bool\",\"default\":true},{\"name\":\"angle\",\"title\":\"Angle of x-axis labels\",\"type\":\"Number\",\"m