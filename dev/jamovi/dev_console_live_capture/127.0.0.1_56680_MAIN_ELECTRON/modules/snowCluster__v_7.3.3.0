        title: 'Model fit '
        type: Bool
        default: false
      - name: point
        title: 'Prediction intervals '
        type: Bool
        default: false
      - name: plot4
        title: Forcast
        type: Bool
        default: false
      - name: plot5
        title: Model components
        type: Bool
        default: false
      - name: plot6
        title: Comparison
        type: Bool
        default: false
      - name: periods
        title: Number of periods
        type: Integer
        min: 1
        default: 365
      - name: unit
        title: Unit
        type: List
        options:
          - title: hour
            name: hour
          - title: day
            name: day
          - title: week
            name: week
          - title: month
            name: month
          - title: quarter
            name: quarter
          - title: year
            name: year
        default: day
      - name: width1
        type: Integer
        title: 'Size: '
