  - title: Clustering Dendrogram
    name: hc
    ns: snowCluster
    menuGroup: snowCluster
    menuSubgroup: Cluster Plot
    menuTitle: Clustering Dendrogram
    options:
      - name: mode
        title: ''
        type: List
        options:
          - name: simple
            title: Dendrogram
          - name: complex
            title: With p-values
      - name: data
        type: Data
        description:
          R: |
            The data as a data frame.
      - name: labels
        title: Labels (optional)
        type: Variable
        suggested:
          - nominal
        permitted:
          - id
          - factor
      - name: vars
        title: Variables
        type: Variables
      - name: stand
        title: Standardize data
        type: Bool
        default: true
      - name: k
        title: Number of clusters
        default: 2
        type: Integer
        min: 1
      - name: metric
        title: Distance measure
        type: List
        options:
          - euclidean
          - manhattan
          - maximum
          - canberra
          - binary
          - minkowski
        default: euclidean
      - name: method
        title: Clustering method
        type: List
        options:
          - ward.D
          - ward.D2
          - single
          - complete
          - average
        default: ward.D2
      - name: type
        title: Type of plot
        type: List
        options:
          - rectangle
          - circular
          - phylogenic
        default: rectangle
      - name: plot
        title: Cluster Dendrogram
        type: Bool
        default: false
      - name: clust
        title: Cluster number
        type: Output
      - name: horiz
        title: horizontal
        type: Bool
        default: false
      - name: width
        type: Integer
        title: 'Width '
        default: 500
      - name: height
        type: Integer
        title: Height
        default: 500
      - name: vars1
        title: Variables
        type: Variables
      - name: method1
        title: Clustering method
        type: List
        options:
          - average
          - median
          - centroid
          - ward.D
          - ward.D2
          - single
          - complete
          - mcquitty
        default: average
      - name: nb
        title: Number of bootstrap
        default: 1000
        type: Integer
        min: 10
      - name: dm
        title: Distance measure
        type: List
        options:
          - correlation
          - uncentered
          - abscor
        default: correlation
      - name: plot1
        title: Dendrogram
        type: Bool
        default: false
      - name: width1
        type: Integer
        title: 'Size: '
        default: 500
      - name: height1
        type: Integer
