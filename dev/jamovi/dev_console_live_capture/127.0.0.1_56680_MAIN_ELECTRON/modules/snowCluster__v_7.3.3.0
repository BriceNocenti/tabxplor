  - title: PCA & Group plot
    name: pca
    ns: snowCluster
    menuGroup: snowCluster
    menuTitle: PCA & Group plot
    menuSubgroup: Cluster Plot
    options:
      - name: data
        type: Data
        description:
          R: |
            The data as a data frame.
      - name: mode
        title: ''
        type: List
        options:
          - name: simple
            title: PCA Plot
          - name: complex
            title: Group Plot
        default: simple
      - name: labels
        title: Labels (Optional)
        type: Variable
        suggested:
          - id
        permitted:
          - id
          - factor
      - name: vars
        title: Variables
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: eigen
        title: Eigenvalues
        type: Bool
        default: false
      - name: plot
        title: Variable contributions
        type: Bool
        default: false
      - name: plot1
        title: Individual plot
        type: Bool
        default: false
      - name: plot2
        title: Biplot
        type: Bool
        default: false
      - name: vars1
        title: Variables
        type: Variables
        suggested:
          - continuous
        permitted:
          - numeric
      - name: facs
        title: Factor(Required)
        type: Variable
        suggested:
          - nominal
        permitted:
          - factor
      - name: plot3
        title: Individuals by groups
        type: Bool
        default: false
      - name: plot4
        title: PCA-Biplot
        type: Bool
        default: false
      - name: width
        type: Integer
        title: 'Size: '
        default: 500
