.Rproj.user
.Rhistory
.Rdata
.httr-oauth
.DS_Store
inst/doc

# Generated benchmark fixtures: large, regenerable, never commit.
# big_pc18_full_15M.rds (572 MB) was tracked by mistake and purged from history --
# it is over GitHub's 100 MB hard limit, so re-adding it would break the push.
dev/benchmarks/big_df.rds
dev/benchmarks/big_pc18_full_15M.rds
dev/benchmarks/results_*.csv

# Dev-console captures: keep the unzipped folders (they are the readable reference),
# never the zips -- they are pure duplicates of those folders.
dev/jamovi/dev_console_live_capture/*.zip

# jamovi options js
jamovi/ui/*.options.js

# packaged module
*.jmo


# build folders
build/
build*/


inst/doc

# Built pkgdown site: generated output, deployed to gh-pages by CI (.github/workflows/pkgdown.yaml)
docs/

# Claude Code personal settings (project config in .claude/settings.json is tracked)
.claude/settings.local.json

# Device output left behind by running the plotting examples (or_plot / lm_plots / tab_plot)
# locally: harmless, but it lands in the package root and R CMD check NOTEs it as a
# "Non-standard file/directory found at top level".
Rplots.pdf

# An exported Positron settings.json carries live secrets (a claudeQuota session key, an org id).
# Untracked on purpose -- this line is what stops a `git add -A` from publishing it.
dev/Positron_Windows_settings.json

/.quarto/
**/*.quarto_ipynb
